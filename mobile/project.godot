; Godot4.6.3 standard; native station prototype. No Unity/.NET dependency.
config_version=5

[application]
config/name="Warehouse Simulator — Station Edition"
config/version="0.2.0-station"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/vsync/vsync_mode=0

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
lights_and_shadows/directional_shadow/size=1024
textures/default_filters/anisotropic_filtering_level=1
textures/vram_compression/import_etc2_astc=true

[physics]
common/physics_ticks_per_second=30

[audio]
driver/enable_input=false
